# Supabase: copy the Session pooler URI from Connect, insert your URL-encoded
# database password, and append ?sslmode=require. Generic postgresql:// works too.
DATABASE_URL=postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_ENCODED_DB_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
# Supabase Storage: create a PRIVATE homework bucket and copy the S3 settings.
# These AWS-prefixed variables contain SUPABASE S3 keys, not Supabase API keys.
S3_BUCKET=homework
S3_REGION=YOUR_SUPABASE_REGION
S3_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_KEY
AWS_SESSION_TOKEN=

# For offline development use DATABASE_URL=sqlite:///./data/verity.db and leave
# S3_BUCKET and both AWS credential values empty. The guided demo does this itself.
STORAGE_DIR=./data/documents
CORS_ORIGINS=["http://localhost:3000"]
EXTERNAL_AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=high
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_JWKS_URL=
LOCAL_TOKENS_ENABLED=true
MAX_PDF_PAGES=10
MAX_UPLOAD_BYTES=20971520
WORKER_POLL_SECONDS=2
